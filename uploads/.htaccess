Options -Indexes

# Запрет выполнения скриптов в каталоге загрузок
<FilesMatch "\.(php|phtml|phar|cgi|pl|asp|aspx|jsp|sh|exe|bat|cmd)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Разрешены только изображения
<FilesMatch "\.(jpe?g|png|gif|webp)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Disposition "inline"
</IfModule>
