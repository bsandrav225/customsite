Options -Indexes

<FilesMatch "\.(php|phtml|phar|cgi|pl|asp|aspx|jsp|sh|exe|bat|cmd|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
